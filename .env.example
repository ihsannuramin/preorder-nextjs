
# Environment Variables for POHub
# ── Supabase ────────────────────────────────────────────────────────────────
# From: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Database (Prisma) ────────────────────────────────────────────────────────
# From: Supabase > Project Settings > Database > Connection String
# Transaction pooler (port 6543) — for runtime queries
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (port 5432) — for migrations and prisma db push
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=POHub

# ── Supabase Storage Buckets ─────────────────────────────────────────────────
# Create these buckets in Supabase Dashboard > Storage
NEXT_PUBLIC_STORAGE_BUCKET_PRODUCTS=product-images
NEXT_PUBLIC_STORAGE_BUCKET_STORES=store-assets
NEXT_PUBLIC_STORAGE_BUCKET_PAYMENTS=payment-proofs

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Email auth (lupa password, konfirmasi daftar) dikirim Supabase Auth — sender &
# SMTP diatur di Supabase Dashboard, bukan di sini. Lihat docs/email-setup.md.
# Dua variabel di bawah dicadangkan untuk email transaksional (belum dipakai kode).
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@pohub.app

# ── Monitoring (Sentry) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ── Analytics (PostHog) ──────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
