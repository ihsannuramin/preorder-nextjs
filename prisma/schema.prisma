generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  SUPER_ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CampaignStatus {
  DRAFT
  OPEN
  CLOSED
  PRODUCTION
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAID
  PRODUCTION
  READY
  COMPLETED
  CANCELLED
}

enum GroupOrderStatus {
  COLLECTING
  CLOSED
  PAYMENT_REVIEW
  PAID
  CANCELLED
}

enum Unit {
  GRAM
  KILOGRAM
  ML
  LITER
  PCS
  PACK
}

enum ProductCategory {
  BEVERAGE
  FOOD
  DESSERT
  FROZEN_FOOD
  SNACK
  FASHION
  CRAFT
  ACCESSORY
  ELECTRONIC
  HOUSEHOLD
  BEAUTY
  OTHER
}

enum ProductCostMode {
  RECIPE
  MANUAL
}

enum IngredientCategory {
  BAHAN_UTAMA
  BAHAN_TAMBAHAN
  KEMASAN
  OTHER
}

enum StockMovementType {
  PURCHASE
  DEDUCTION
  ADJUSTMENT
}

enum StockAdjustmentReason {
  CORRECTION
  EXPIRED
  LOST
  DAMAGED
  WASTE
}

enum ProductionRecordStatus {
  COMPLETED
  CANCELLED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  supabaseId   String   @unique
  email        String   @unique
  businessName String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store Store?

  @@map("users")
}

model AdminAuditLog {
  id            String   @id @default(cuid())
  actorUserId   String
  actorEmail    String
  action        String
  targetStoreId String?
  targetUserId  String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([actorUserId])
  @@index([targetStoreId])
  @@map("admin_audit_logs")
}

model Store {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  coverUrl    String?
  whatsapp    String?
  instagram   String?
  socialLinks Json?
  googleMapsUrl  String?
  showGoogleMaps Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]
  ingredients Ingredient[]
  campaigns   Campaign[]

  @@map("stores")
}

model Product {
  id           String          @id @default(cuid())
  storeId      String
  name         String
  description  String?
  imageUrl     String?
  images       String[]        @default([])
  category     ProductCategory @default(OTHER)
  costMode     ProductCostMode @default(RECIPE)
  manualCostPrice Decimal?     @db.Decimal(12, 2)
  basePrice    Decimal         @db.Decimal(12, 2)
  status       ProductStatus   @default(DRAFT)
  displayOrder Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  recipeItems       RecipeItem[]
  campaignProducts  CampaignProduct[]
  additionalCosts   AdditionalCost[]
  productionRecords ProductionRecord[]
  orderItems        OrderItem[]
  groupMemberOrderItems GroupMemberOrderItem[]

  @@map("products")
}

model AdditionalCost {
  id        String   @id @default(cuid())
  productId String
  label     String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("additional_costs")
}

model Ingredient {
  id            String             @id @default(cuid())
  storeId       String
  name          String
  category      IngredientCategory @default(OTHER)
  unit          Unit
  supplier      String?
  purchaseQty   Decimal            @db.Decimal(12, 4)
  purchasePrice Decimal            @db.Decimal(12, 2)
  currentStock  Decimal            @default(0) @db.Decimal(12, 4)
  averageCost   Decimal            @default(0) @db.Decimal(12, 4)
  minimumStock  Decimal            @default(0) @db.Decimal(12, 4)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  recipeItems    RecipeItem[]
  stockMovements StockMovement[]

  @@map("ingredients")
}

model StockMovement {
  id             String                 @id @default(cuid())
  ingredientId   String
  type           StockMovementType
  reason         StockAdjustmentReason?
  quantityChange Decimal                @db.Decimal(12, 4)
  resultingStock Decimal                @db.Decimal(12, 4)
  unitCost       Decimal?               @db.Decimal(12, 2)
  note           String?
  referenceId    String?
  performedBy    String
  createdAt      DateTime               @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId, createdAt])
  @@map("stock_movements")
}

model RecipeItem {
  id           String   @id @default(cuid())
  productId    String
  ingredientId String
  quantity     Decimal  @db.Decimal(12, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@map("recipe_items")
}

model Campaign {
  id          String         @id @default(cuid())
  storeId     String
  name        String
  description String?
  openDate    DateTime
  closeDate   DateTime
  status      CampaignStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products          CampaignProduct[]
  orders            Order[]
  groupOrders       GroupOrder[]
  productionSheet   ProductionSheet?
  productionRecords ProductionRecord[]

  @@map("campaigns")
}

model CampaignProduct {
  id         String   @id @default(cuid())
  campaignId String
  productId  String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@map("campaign_products")
}

model Order {
  id               String      @id @default(cuid())
  campaignId       String
  orderNumber      String      @unique
  customerName     String
  customerPhone    String
  customerAddress  String
  customerNotes    String?
  totalAmount      Decimal     @db.Decimal(12, 2)
  totalHpp         Decimal     @default(0) @db.Decimal(12, 2)
  status           OrderStatus @default(PENDING_PAYMENT)
  paymentProofUrl  String?
  paymentNote      String?
  rejectionReason  String?
  verifiedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  campaign Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  items    OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  unitPrice   Decimal  @db.Decimal(12, 2)
  unitHpp     Decimal  @default(0) @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model ProductionSheet {
  id          String    @id @default(cuid())
  campaignId  String    @unique
  generatedAt DateTime  @default(now())
  startedAt   DateTime?
  updatedAt   DateTime  @updatedAt

  campaign Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  items    ProductionSheetItem[]

  @@map("production_sheets")
}

model ProductionRecord {
  id             String                 @id @default(cuid())
  productId      String
  campaignId     String
  quantity       Int
  producedBy     String
  productionDate DateTime               @default(now())
  status         ProductionRecordStatus @default(COMPLETED)
  totalCost      Decimal                @db.Decimal(12, 2)
  createdAt      DateTime               @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([productId])
  @@map("production_records")
}

model ProductionSheetItem {
  id                String   @id @default(cuid())
  productionSheetId String
  ingredientId      String
  ingredientName    String
  unit              Unit
  totalQuantity     Decimal  @db.Decimal(12, 4)
  estimatedCost     Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  productionSheet ProductionSheet @relation(fields: [productionSheetId], references: [id], onDelete: Cascade)

  @@map("production_sheet_items")
}

model GroupOrder {
  id                 String           @id @default(cuid())
  campaignId         String
  sessionCode        String           @unique
  facilitatorName    String
  facilitatorPhone   String
  facilitatorAddress String
  facilitatorNotes   String?
  status             GroupOrderStatus @default(COLLECTING)
  totalAmount        Decimal          @default(0) @db.Decimal(12, 2)
  paymentProofUrl    String?
  paymentNote        String?
  rejectionReason    String?
  verifiedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  campaign     Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  memberOrders GroupMemberOrder[]

  @@map("group_orders")
}

model GroupMemberOrder {
  id           String   @id @default(cuid())
  groupOrderId String
  memberName   String
  subtotal     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  groupOrder GroupOrder             @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  items      GroupMemberOrderItem[]

  @@map("group_member_orders")
}

model GroupMemberOrderItem {
  id            String   @id @default(cuid())
  memberOrderId String
  productId     String?
  productName   String
  unitPrice     Decimal  @db.Decimal(12, 2)
  quantity      Int
  subtotal      Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  memberOrder GroupMemberOrder @relation(fields: [memberOrderId], references: [id], onDelete: Cascade)
  product     Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("group_member_order_items")
}
